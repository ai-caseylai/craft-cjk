@@ -389,7 +389,21 @@ fn first_supported(list: &str) -> Option<Lang> {
 
 #[cfg(target_arch = "wasm32")]
 fn detect_system_lang() -> Lang {
-    Lang::EN
+    // Drive deployment: this returned Lang::EN unconditionally, so the web build could never
+    // pick a shipped translation such as zh-hant, however the browser was configured.
+    let mut tags: Vec<String> = Vec::new();
+    if let Some(win) = web_sys::window() {
+        let nav = win.navigator();
+        for v in nav.languages().iter() {
+            if let Some(s) = v.as_string() {
+                tags.push(s);
+            }
+        }
+        if let Some(one) = nav.language() {
+            tags.push(one);
+        }
+    }
+    tags.iter().find_map(|t| lang_from_tag(t)).unwrap_or(Lang::EN)
 }
 
