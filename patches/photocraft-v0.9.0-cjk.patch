+/// The browser's own preference list.
+///
+/// This used to return an empty `Vec`, so `resolve` fell back to `Lang::EN` on every web build and
+/// a shipped translation such as `zh-hant` could never be selected, however the browser was
+/// configured. `navigator.languages` is the ordered list Chrome and Firefox expose;
+/// `navigator.language` is the single-value fallback for browsers that omit it.
 #[cfg(all(not(test), target_arch = "wasm32"))]
 fn detect_system_tags() -> Vec<String> {
-    Vec::new()
+    let mut tags: Vec<String> = Vec::new();
+    if let Some(win) = web_sys::window() {
+        let nav = win.navigator();
+        // `Navigator::languages()` returns the js Array directly (no Result); `language()` is the
+        // Option<String> single-value fallback.
+        for v in nav.languages().iter() {
+            if let Some(s) = v.as_string() {
+                tags.push(s);
+            }
+        }
+        if tags.is_empty() {
+            if let Some(one) = nav.language() {
+                tags.push(one);
+            }
+        }
+    }
+    bounded_tags(tags)
 }
 
