@@ -52,9 +52,23 @@ pub struct Sources {
     pub embedded: fn(CjkScript) -> Vec<&'static CraftFont>,
 }
 
+/// Embedded craft-fonts faces whose manifest scripts list the given tag, in manifest order.
+fn craft_embedded_listing(tag: &str) -> Vec<&'static CraftFont> {
+    craft_fonts::CRAFT_FONTS.iter().filter(|f| f.scripts.contains(&tag)).collect()
+}
+
 /// craft-fonts' Japanese fonts for the Japanese script, UI face first (empty without craft-fonts).
 pub fn craft_embedded(script: CjkScript) -> Vec<&'static CraftFont> {
-    if script == CjkScript::Japanese { craft_fonts::japanese_for_ui() } else { Vec::new() }
+    match script {
+        CjkScript::Japanese => craft_fonts::japanese_for_ui(),
+        // Drive deployment: the web build embeds no system fonts, and upstream routes
+        // only the Japanese face through the embedded hook, so the UI's Chinese had no
+        // source at all and every label rendered as tofu. Route the embedded craft-fonts
+        // face for the Chinese scripts too.
+        CjkScript::SimplifiedChinese => craft_embedded_listing("Hans"),
+        CjkScript::TraditionalChinese => craft_embedded_listing("Hant"),
+        _ => Vec::new(),
+    }
 }
 
